<Application
    x:Class="FindMyPhone.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:FindMyPhone.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToScanTextConverter x:Key="BoolToScanTextConverter"/>
            <converters:RssiToBrushConverter x:Key="RssiToBrushConverter"/>
            <converters:DistanceToLabelConverter x:Key="DistanceToLabelConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>